<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/libri_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_sketch_card"
            android:elevation="4dp"
            android:padding="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFrameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사진 촬영 중"
                    android:textColor="@color/libri_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="카메라를 응시하고 포즈를 취해주세요"
                    android:textColor="@color/libri_pencil"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtShotProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 / 4"
                android:textColor="@color/libri_ink"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_highlighter"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <!-- Camera Viewfinder Container -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="#1E1A18"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/cameraPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="카메라 준비 중..."
                android:textColor="#A09890"
                android:textSize="15sp"
                android:layout_centerInParent="true" />

            <!-- Countdown Circle Overlay -->
            <TextView
                android:id="@+id/txtCountdown"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="52sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_countdown_circle"
                android:layout_centerInParent="true"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- 4-Cut Progress Slots Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_sketch_card"
            android:elevation="4dp"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="촬영 현황"
                android:textColor="@color/libri_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/slot1"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="1컷"
                    android:textColor="@color/libri_pencil"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:background="@drawable/bg_frame_box"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/slot2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="2컷"
                    android:textColor="@color/libri_pencil"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:background="@drawable/bg_frame_box"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/slot3"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="3컷"
                    android:textColor="@color/libri_pencil"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:background="@drawable/bg_frame_box"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/slot4"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="4컷"
                    android:textColor="@color/libri_pencil"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:background="@drawable/bg_frame_box" />
            </LinearLayout>
        </LinearLayout>

        <!-- Capture Trigger Button -->
        <Button
            android:id="@+id/btnTakeNextPhoto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="촬영하기 (3초 카운트다운)"
            android:textSize="16sp"
            android:textColor="@color/libri_ink"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_libri_primary"
            android:stateListAnimator="@null"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="이전"
                android:textSize="14sp"
                android:textColor="@color/libri_ink"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_libri_secondary"
                android:stateListAnimator="@null"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="홈으로"
                android:textSize="14sp"
                android:textColor="@color/libri_ink"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_libri_secondary"
                android:stateListAnimator="@null"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>